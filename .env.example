# ============================================================
# Template konfigurasi — Bank Jatim SNAP API Integration Tester
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit .env ke repository.
# ============================================================

# ===== Aplikasi =====
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://qrisbj.lksbarokah255.my.id

# Password untuk login dashboard (kosongkan untuk menonaktifkan autentikasi).
# Wajib diganti dengan nilai yang kuat sebelum deployment ke publik.
APP_AUTH_PASSWORD=CHANGE_THIS_PASSWORD

# ===== Docker =====
APP_PORT=8080

# ===== Database =====
# Pada Docker, DB_HOST harus bernilai "db" (nama service).
DB_HOST=db
DB_PORT=3306
DB_DATABASE=test-qris-bj
DB_USERNAME=qris_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# ===== Bank Jatim (nilai diperoleh dari Bank Jatim) =====
# Base URL API (sandbox/production). Kosongkan jika belum tersedia —
# aplikasi akan menolak request sampai nilai ini diisi.
BANK_JATIM_BASE_URL=

# Client ID & Client Secret dari Bank Jatim.
BANK_JATIM_CLIENT_ID=
BANK_JATIM_CLIENT_SECRET=

# Metode signature: symmetric (HMAC-SHA512) atau asymmetric (SHA256withRSA).
BANK_JATIM_SIGNATURE_METHOD=symmetric

# Path private key PKCS8 (hanya untuk metode asymmetric).
# Relatif terhadap root project, di luar direktori public.
BANK_JATIM_PRIVATE_KEY_PATH=storage/keys/private.pem

# Partner ID (X-PARTNER-ID) dari Bank Jatim.
BANK_JATIM_PARTNER_ID=

# Channel ID default (00002 untuk layanan QR MPM).
BANK_JATIM_CHANNEL_ID=00002

# Timeout HTTP request (detik).
BANK_JATIM_TIMEOUT=30

# ===== Nilai default formulir QR MPM (opsional, agar formulir terisi otomatis) =====
BANK_JATIM_MERCHANT_ID=
BANK_JATIM_STORE_ID=
BANK_JATIM_TERMINAL_ID=
